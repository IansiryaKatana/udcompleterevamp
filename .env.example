# Copy to `.env` locally. Set the same keys in Netlify / Hostinger dashboards for production.

# Supabase (required for live CMS, auth, checkout)
VITE_SUPABASE_URL=https://oelolusdbaoyiqkgukib.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server/import only — never expose in Vite client code or commit real values
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hostinger / Node server (optional — defaults shown)
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=production

# Build target (do not set in host dashboards — use npm scripts instead)
# DEPLOY_TARGET=node      → npm run build:hostinger
# DEPLOY_TARGET=netlify   → npm run build:netlify

# Deploy edge functions after migrations:
# - subscribe-newsletter
# - request-quote
# - create-checkout-session
# - verify-checkout-session
# - stripe-webhook
# - admin-stripe-config
#
# Stripe webhook URL: https://oelolusdbaoyiqkgukib.supabase.co/functions/v1/stripe-webhook
#
# Quote emails (Supabase project secrets, not in this file):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Unique Distribution <sales@uniquedistribution.com>
#
# Worldpay gateway (Phase 2F — PRODUCT UNCONFIRMED; keep gateway_mode=disabled)
# Do not set WORLDPAY_GATEWAY_MODE=test|live until the business confirms the exact
# Worldpay product (Access vs WPG vs Shopify-plugin-only) and supplies TEST credentials.
# WORLDPAY_GATEWAY_MODE=disabled
# WORLDPAY_PRODUCT=            # e.g. access_payments | corporate_gateway | unconfirmed
# WORLDPAY_MERCHANT_ENTITY=
# WORLDPAY_API_USERNAME=
# WORLDPAY_API_PASSWORD=
# WORLDPAY_WEBHOOK_SECRET=
# WORLDPAY_ENVIRONMENT=try     # never use live URLs here until a later activation phase

# DPD carrier (Phase 3C — PRODUCT/API STILL UNCONFIRMED; carrier_mode=disabled)
# Historical: Shopify "DPD Integration by WSA" → www.dpdlocal.co.uk / www.dpd.co.uk
# Do NOT invent API family/endpoints. Do NOT set CARRIER_MODE=test|live until:
#   exact product confirmed + official TEST docs/credentials + service codes + approval.
# CARRIER_MODE=disabled
# DPD_PRODUCT_KEY=dpd_uk_unconfirmed
# DPD_PRODUCT_STATUS=unconfirmed
# DPD_API_FAMILY=                 # fill only when confirmed from official account docs
# DPD_TEST_BASE_URL=              # official TEST URL only — never invent
# DPD_LIVE_BASE_URL=              # document only in Phase 3C; do not use
# DPD_TEST_ACCOUNT=
# DPD_TEST_USERNAME=
# DPD_TEST_PASSWORD=
# DPD_WEBHOOK_SECRET=

# SKULabs WMS (Phase 3E — ACCESS NOT AVAILABLE until business supplies read-only creds)
# Official public API docs exist (api.skulabs.com) but this project has no Unique account token.
# Do NOT invent calls against live Unique data without a read-only API key / export.
# Prefer read-only scopes. Never commit real tokens. Never mutate inventory/orders/POs.
# SKULABS_ACCESS_MODE=disabled
# SKULABS_API_BASE_URL=https://api.skulabs.com
# SKULABS_API_TOKEN=
# SKULABS_STORE_ID=
# SKULABS_ACCOUNT_LABEL=
